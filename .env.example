# ---- App ----
APP_ENV=development            # development | production
PORT=8080
PUBLIC_URL=http://localhost:5173
WEB_DIR=../frontend/dist       # built frontend served by the API in production
UPLOAD_DIR=./uploads

# ---- Database ----
DATABASE_URL=postgres://sawyun:sawyun@localhost:5433/sawyun?sslmode=disable

# ---- Auth ----
ADMIN_EMAIL=admin@example.com  # first admin account, created on startup
COOKIE_SECURE=false            # true behind HTTPS
COOKIE_SAMESITE=lax            # lax | strict | none (none only if web and API are on different sites; needs COOKIE_SECURE=true)
SESSION_TTL_HOURS=720          # absolute lifetime (30 days)
SESSION_IDLE_HOURS=168         # sign out after 7 days idle
SESSION_MAX_PER_USER=5
OTP_SECRET=change-me-to-a-long-random-string
OTP_SHOW_CODE=false            # true = API returns the code and the website shows it in a pop-up (demo/presentation only, no email)

# ---- SMTP (OTP emails) ----
SMTP_HOST=                     # empty = OTP codes only printed in the API log; e.g. smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM="Sawyun Ecommerce <no-reply@example.com>"

# ---- CORS: browser origins allowed to call the API with cookies (comma separated) ----
# Dev: the Vite server. Split hosting: the Vercel/frontend URL(s), e.g. https://shop.example.com
CORS_ORIGIN=http://localhost:5173
TRUST_PROXY=false              # true only behind a reverse proxy that sets X-Forwarded-For
